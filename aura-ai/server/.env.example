OPENAI_API_KEY=sk-your-key-here

# Optional overrides:
# AURA_REALTIME=1                                (speech-to-speech; ~1.5s vs ~4.2s. Set 0 to
#                                                 use the transcribe->chat->speak pipeline)
# AURA_REALTIME_MODEL=gpt-realtime
# AURA_CHAT_MODEL=gpt-4o-mini
# AURA_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe   (whisper-1 works but is ~1.3s slower)
# AURA_TTS_MODEL=tts-1                           (gpt-4o-mini-tts sounds nicer but is slower)
# AURA_MAX_REPLY_TOKENS=120
# AURA_PORT=8000
# Used when you ask about the weather without naming a place.
# You can also just tell Aura where you live and it'll remember.
# AURA_DEFAULT_LOCATION=Cape Town
# AURA_WEATHER_UNITS=metric        (or 'imperial' for °F / mph)
# (TTS voice is set per-persona in server/personality.py, not here)

# Optional: run over HTTPS with a self-signed cert (see README) so mic access works
# over WiFi without a Chrome flag.
# AURA_SSL_CERT=cert.pem
# AURA_SSL_KEY=key.pem
